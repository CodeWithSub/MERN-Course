<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>mini whatsapp</title>
  <link rel="stylesheet" href="index.css">
</head>

<body>
  <h3>
    All chats
  </h3>
  <form action="/chats/new">
    <button class="new-btn">New chat</button>
  </form>
  <div class="all-chats">
    <% for (let chat of chats) { %>
      <div class="chat">
        <p>From: <%= chat.from %>
        </p>
        <div class="msg-container">
          <p class="msg">
            <%= chat.msg %>
          </p>
          <div class="btn-container">
            <form action="/chats/<%= chat._id %>/edit">
              <button>Edit</button>
            </form>
            <form method="post" action="/chats/<%= chat._id %>?_method=DELETE" onsubmit="return confirmDelete()">
              <button>Delete</button>
            </form>
          </div>
        </div>
        <p>Received by: <%= chat.to %>
        </p>
        <hr>
        <!-- Extracts the time (HH:MM:SS) from the created_at Date object -->
        <div class="chat-timestamp">
          <p>
            <%= chat.created_at.toString().split(" ")[4] %> </p>
      <p> <%= chat.created_at.toString().split(" ").slice(0,4).join(" -") %>
          </p>
        </div>
      </div>
      <% } %>
  </div>
  <script>
    function confirmDelete() {
      return confirm("Are you sure you want to delete this chat?");
    }
  </script>
</body>

</html>