<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New chat</title>
</head>
<body>
  <h3>Write new chat</h3>
  <form action="/chats" method="post">
    <input type="text" name="from" placeholder="Who are you?"><br><br>
    <textarea name="msg" cols="30" rows="2" placeholder="Write your message here"></textarea><br><br>
    <input type="text" name="to" placeholder="Add receiver">
    <button>send</button>
  </form>
</body>
</html>